# Keep the build context small and the image clean.
.venv/
venv/
.run/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.git/
.github/
.DS_Store
tests/
brand/
data/gbd.db
data/*.db*
data/*.previous
data/.*.building-*
site/
data/incoming/*
!data/incoming/.gitkeep

# Secrets never enter an image. Pass configuration at run time instead.
.env
.env.*
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx
credentials*.json
