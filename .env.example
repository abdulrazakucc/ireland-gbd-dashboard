# Copy to .env and adjust. .env is git-ignored and never copied into an image.
# `make run` passes it to the app; `make up` / docker compose read it too.
# Every setting is optional -- the defaults below are what applies when unset.

# Host port for `make up` (inside the container the app is always on 8000).
# GBD_PORT=8000
# Bind to this interface. Loopback is the safe default for local research use.
# GBD_BIND_ADDRESS=127.0.0.1

# Release label for an import when neither --release nor the filename names one.
# GBD_ROUND=GBD 2023

# Browser origins allowed to call the API from another website, comma-separated.
# Leave empty unless a separate web app really needs it: the application itself,
# notebooks, R and curl do not use CORS. Never use "*".
# GBD_CORS_ORIGINS=https://publichealth.ucc.ie

# Sign-in. "password" (the default) checks email and password against the
# accounts file -- create accounts with `make user-add EMAIL=...`. "proxy" trusts
# an identity-aware reverse proxy instead (see below).
# GBD_AUTH_MODE=password
# GBD_USERS_FILE=./data/access/users.json
# How long a sign-in lasts, in hours.
# GBD_SESSION_HOURS=12
# Signs session cookies. Required in production: at least 32 unpredictable
# characters, preferably in a mounted file. Without one in development, a
# random key is used and sessions simply end when the app restarts.
# GBD_SESSION_SECRET_FILE=/run/secrets/gbd_session_secret
# GBD_SESSION_SECRET=

# Production refuses to start without sign-in (password or proxy mode).
# GBD_ENV=production
# GBD_TRUSTED_HOSTS=gbd.example.ucc.ie

# Proxy mode only: the proxy must remove inbound copies of these headers,
# authenticate the user, then set both headers on the upstream call. Keep the
# secret in the host's secret manager -- never in this file.
# GBD_AUTH_USER_HEADER=X-Forwarded-User
# GBD_PROXY_SECRET_FILE=/run/secrets/gbd_proxy_secret
# GBD_PROXY_SECRET=                 # non-container fallback; file is preferred

# Interactive API documentation (/docs and /openapi.json). Off by default;
# switch on only for local development, never on a shared server.
# GBD_EXPOSE_DOCS=true

# Local runs only. The container sets its own paths (/srv/data/gbd.db).
# GBD_DATA_DIR=./data
# GBD_DB_PATH=./data/gbd.db
