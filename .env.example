# Copy to .env and adjust. .env is git-ignored and never copied into an image.
# `make run` passes it to the app; `make up` / docker compose read it too.
# Every setting is optional -- the defaults below are what applies when unset.

# Host port for `make up` (inside the container the app is always on 8000).
# GBD_PORT=8000

# Release label for an import when neither --release nor the filename names one.
# GBD_ROUND=GBD 2023

# Browser origins allowed to call the API from another website, comma-separated.
# Leave empty unless a separate web app really needs it: the dashboard itself,
# notebooks, R and curl do not use CORS. Never use "*".
# GBD_CORS_ORIGINS=https://publichealth.ucc.ie

# Local runs only. The container sets its own paths (/srv/data/gbd.db).
# GBD_DATA_DIR=./data
# GBD_DB_PATH=./data/gbd.db
