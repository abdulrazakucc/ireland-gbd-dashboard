# Virtual environment -- recreate with: make setup
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local process state (PID and log from `make run`)
.run/
*.log

# Database built by the ETL -- regenerate with: make seed. An import builds a
# hidden .gbd.db.building-* file beside it and keeps the replaced database as
# gbd.db.previous; neither belongs in version control.
data/gbd.db
data/*.db
data/*.db-journal
data/*.previous
data/.*.building-*

# GBD Results Tool exports: large, and redistribution is governed by IHME's
# data terms. Keep them out of version control.
data/incoming/*
!data/incoming/.gitkeep

# Written by `pyenv local` when following INSTALL_WINDOWS.md. The project
# supports Python 3.11+, so one machine's exact patch version is not something
# to pin for everyone.
.python-version

# Downloaded by the pyenv-win bootstrap in INSTALL_WINDOWS.md, if that step is
# run from inside the project folder.
install-pyenv-win.ps1

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# Editors
# .vscode/ is ignored apart from the two files that are genuinely shared:
# the extension recommendations and the workspace settings that make these
# documents render correctly for everyone.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# Static snapshot built by `make site` and published by CI to GitHub Pages.
# Always regenerated from the database; never edited by hand.
site/

# Secrets and credentials. Configuration lives in .env (copy .env.example);
# only the example, which holds no real values, is committed.
.env
.env.*
!.env.example
secrets/
.secrets/
*.secret
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.netrc
credentials.json
*-credentials.json
*_credentials.json
client_secret*.json
service-account*.json
